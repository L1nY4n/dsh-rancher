{
  "name": "dsh-rancher",
  "version": "0.2.9",
  "type": "module",
  "description": "Rancher cluster, node, Pod and workload management inside DeepSeek Harness",
  "author": "L1nY4n",
  "repository": { "type": "git", "url": "https://github.com/L1nY4n/dsh-rancher.git" },
  "bugs": { "url": "https://github.com/L1nY4n/dsh-rancher/issues" },
  "homepage": "https://github.com/L1nY4n/dsh-rancher#readme",
  "keywords": ["dsh-plugin", "rancher", "kubernetes", "deepseek-harness"],
  "main": "./index.js",
  "exports": { ".": "./index.js", "./client": "./client.js", "./package.json": "./package.json" },
  "files": ["index.js", "client.js", "src", "cordis.patch.yml", "README.md", "LICENSE"],
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "test:ui": "node scripts/test-ui.mjs",
    "test:host": "node scripts/test-host.mjs",
    "dev": "node scripts/preview.mjs",
    "prepack": "npm run build && npm test"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": [] }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.468.0",
    "playwright": "^1.58.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "license": "MIT"
}
